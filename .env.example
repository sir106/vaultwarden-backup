# ==============================================================================
# Vaultwarden Backup Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Put all values in double quotes to avoid parsing issues.
# 2. Map/mount this file to `/.env` in the container (e.g. -v /path/to/.env:/.env).
# 3. For Docker Secrets, you can append `_FILE` to variable names pointing to secret files.
# ==============================================================================

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------
# TIMEZONE="UTC"
# DISPLAY_NAME="vaultwarden"
# CRON="5 * * * *"

# ------------------------------------------------------------------------------
# Rclone Storage Settings
# ------------------------------------------------------------------------------
# RCLONE_REMOTE_NAME="BitwardenBackup"
# RCLONE_REMOTE_DIR="/BitwardenBackup/"
# RCLONE_GLOBAL_FLAG=""

# Additional Remote Destinations (Optional, N starts from 1 consecutively)
# RCLONE_REMOTE_NAME_1=""
# RCLONE_REMOTE_DIR_1=""

# ------------------------------------------------------------------------------
# Backup Archive & Compression
# ------------------------------------------------------------------------------
# ZIP_ENABLE="TRUE"
# ZIP_PASSWORD="WHEREISMYPASSWORD?"
# ZIP_TYPE="zip" # Supported: "zip" or "7z"
# BACKUP_FILE_SUFFIX="%Y%m%d"

# ------------------------------------------------------------------------------
# Retention Policy (Grandfather-Father-Son / GFS)
# ------------------------------------------------------------------------------
# Set all retention variables to "0" to keep all backup files (disable cleanup).
# BACKUP_KEEP_DAYS="7"
# BACKUP_KEEP_WEEKS="4"
# BACKUP_KEEP_MONTHS="12"
# BACKUP_KEEP_YEARS="3"
# BACKUP_KEEP_LAST="0"

# ------------------------------------------------------------------------------
# Notification - Ping (Healthcheck / Webhook)
# ------------------------------------------------------------------------------
# Placeholders %{subject} and %{content} are supported.
# PING_URL=""
# PING_URL_CURL_OPTIONS=""
# PING_URL_WHEN_START=""
# PING_URL_WHEN_START_CURL_OPTIONS=""
# PING_URL_WHEN_SUCCESS=""
# PING_URL_WHEN_SUCCESS_CURL_OPTIONS=""
# PING_URL_WHEN_FAILURE=""
# PING_URL_WHEN_FAILURE_CURL_OPTIONS=""

# ------------------------------------------------------------------------------
# Notification - Mail (SMTP via s-nail)
# ------------------------------------------------------------------------------
# MAIL_SMTP_ENABLE="FALSE"
# MAIL_SMTP_VARIABLES=""
# MAIL_TO=""
# MAIL_WHEN_SUCCESS="TRUE"
# MAIL_WHEN_FAILURE="TRUE"
# MAIL_FORCE_THREAD="FALSE"

# ------------------------------------------------------------------------------
# Database Backend Configuration
# ------------------------------------------------------------------------------
# Supported DB_TYPE: "sqlite" (default), "postgresql", "mysql"
# DB_TYPE="sqlite"

# PostgreSQL Configuration (required when DB_TYPE="postgresql")
# PG_HOST=""
# PG_PORT="5432"
# PG_DBNAME="vaultwarden"
# PG_USERNAME="vaultwarden"
# PG_PASSWORD=""

# MySQL / MariaDB Configuration (required when DB_TYPE="mysql")
# MYSQL_HOST=""
# MYSQL_PORT="3306"
# MYSQL_DATABASE="vaultwarden"
# MYSQL_USERNAME="vaultwarden"
# MYSQL_PASSWORD=""
# MYSQL_SSL=""
# MYSQL_SSL_VERIFY_SERVER_CERT=""
# MYSQL_SSL_CA=""
# MYSQL_SSL_CERT=""
# MYSQL_SSL_KEY=""

# ------------------------------------------------------------------------------
# Advanced Data Paths (Optional)
# ------------------------------------------------------------------------------
# DATA_DIR="/bitwarden/data"
# DATA_DB="/bitwarden/data/db.sqlite3"
# DATA_RSAKEY="/bitwarden/data/rsa_key"
# DATA_ATTACHMENTS="/bitwarden/data/attachments"
# DATA_SENDS="/bitwarden/data/sends"
